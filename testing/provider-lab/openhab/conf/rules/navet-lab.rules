rule "Seed Navet provider lab"
when
  System started
then
  createTimer(now.plusSeconds(10), [ |
    NavetLivingCeiling_Power.postUpdate(ON)
    NavetLivingCeiling_Brightness.postUpdate(72)
    NavetLivingAccent_Color.postUpdate("28,75,68")
    NavetKitchenCoffee_Power.postUpdate(OFF)
    NavetKitchenCoffee_PowerUsage.postUpdate("0 W")
    NavetKitchenCoffee_Energy.postUpdate("12.45 kWh")
    NavetLiving_Temperature.postUpdate("21.6 °C")
    NavetLiving_Humidity.postUpdate("46 %")
    NavetLiving_CO2.postUpdate("612 ppm")
    NavetGarden_Illuminance.postUpdate("380 lx")
    NavetHallway_FrontDoor.postUpdate(CLOSED)
    NavetHallway_FrontDoorLock.postUpdate(ON)
    NavetHallway_Motion.postUpdate(OFF)
    NavetKitchen_Leak.postUpdate(OFF)
    NavetBedroom_Blind.postUpdate(35)
    NavetBedroom_FanSpeed.postUpdate(40)
    NavetMedia_State.postUpdate("PAUSED")
    NavetMedia_Volume.postUpdate(32)
    NavetLastActivity.postUpdate(now.toString)
    NavetBedroom_Window.postUpdate(OPEN)
    NavetBedroom_WindowBattery.postUpdate("15 %")
    NavetOffice_Presence.postUpdate(OPEN)
    NavetHallway_Smoke.postUpdate(CLOSED)
    NavetHallway_CO.postUpdate(CLOSED)
    NavetHallway_AlarmBattery.postUpdate("12 %")
    NavetOffice_CO2.postUpdate("1240 ppm")
    NavetOffice_PM25.postUpdate(28)
    NavetOffice_TVOC.postUpdate(350)
    NavetBathroom_Temperature.postUpdate("24.2 °C")
    NavetBathroom_Humidity.postUpdate("78 %")
    NavetBedroom_RadiatorTarget.postUpdate("19.5 °C")
    NavetBedroom_RadiatorTemperature.postUpdate("18.8 °C")
    NavetLaundry_WasherPower.postUpdate(ON)
    NavetLaundry_WasherUsage.postUpdate("485 W")
    NavetLaundry_WasherEnergy.postUpdate("38.72 kWh")
    NavetKitchen_FreezerTemperature.postUpdate("-8.5 °C")
    NavetKitchen_FreezerAlarm.postUpdate(OPEN)
    NavetGarden_SoilMoisture.postUpdate("18 %")
    NavetGarden_Irrigation.postUpdate(OFF)
    NavetLaundry_WaterValve.postUpdate(ON)
    NavetLaundry_HousePower.postUpdate("1260 W")
    NavetLaundry_HouseEnergy.postUpdate("824.35 kWh")
    NavetLaundry_WaterMeter.postUpdate("42.875 m³")
    NavetLaundry_GasMeter.postUpdate("168.43 m³")
    NavetGarden_Wind.postUpdate("4.2 m/s")
    NavetGarden_Pressure.postUpdate("1012 hPa")
    NavetGarden_Rain.postUpdate("0.4 mm")
    NavetLiving_Curtains.postUpdate(35)
    logInfo("navet-provider-lab", "Seeded Navet openHAB fixture items")
  ])
end
