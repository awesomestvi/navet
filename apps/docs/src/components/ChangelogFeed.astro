---
import changelogSource from "../../../../CHANGELOG.md?raw";
import { releaseKind as getKind } from "../utils/release-feed";

type ChangeGroup = {
  title: string;
  kind: string;
  items: string[];
};

type Release = {
  version: string;
  date: string;
  groups: ChangeGroup[];
};

const renderInline = (value: string) => value
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")
  .replace(/`([^`]+)`/g, "<code>$1</code>")
  .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2">$1</a>');

const releases: Release[] = [];
let release: Release | undefined;
let group: ChangeGroup | undefined;

for (const rawLine of changelogSource.replace(/\r\n/g, "\n").split("\n")) {
  const line = rawLine.trim();
  const releaseMatch = line.match(/^##\s+([^\s]+)\s+-\s+(\d{4}-\d{2}-\d{2})$/);

  if (releaseMatch) {
    release = { version: releaseMatch[1], date: releaseMatch[2], groups: [] };
    releases.push(release);
    group = undefined;
    continue;
  }

  const groupMatch = line.match(/^##\s+(.+)$/);
  if (groupMatch && release) {
    const title = groupMatch[1];
    group = { title, kind: getKind(title), items: [] };
    release.groups.push(group);
    continue;
  }

  const itemMatch = line.match(/^-\s+(.+)$/);
  if (itemMatch && group) group.items.push(itemMatch[1]);
}

const formatDate = (value: string) => new Date(`${value}T00:00:00Z`).toLocaleDateString("en", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const releaseId = (version: string) => `release-${version.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<div class="navet-changelog" data-changelog>
  <div class="navet-changelog-intro">
    <p>
      Stable Navet releases load from the canonical GitHub release record, followed by the
      historical repository archive.{" "}
      <a href="https://github.com/awesomestvi/navet/releases">View releases on GitHub <span aria-hidden="true">↗</span></a>
    </p>
  </div>

  <p data-release-status role="status">Checking the latest stable releases…</p>

  <div class="navet-changelog-toolbar" aria-label="Filter release notes">
    <div class="navet-changelog-filters" role="group" aria-label="Change type">
      <button type="button" class="is-active" data-change-filter="all" aria-pressed="true">All updates</button>
      <button type="button" data-change-filter="new" aria-pressed="false">New</button>
      <button type="button" data-change-filter="improved" aria-pressed="false">Improved</button>
      <button type="button" data-change-filter="fixed" aria-pressed="false">Fixed</button>
      <button type="button" data-change-filter="security" aria-pressed="false">Security</button>
    </div>

    <label class="navet-changelog-search">
      <span class="sr-only">Search releases</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      <input type="search" placeholder="Search updates" data-change-search />
    </label>
  </div>

  <p class="navet-changelog-empty" data-change-empty hidden>No releases match this view.</p>

  <div class="navet-release-list">
    {releases.map((item, index) => {
      return (
        <article
          class="navet-release"
          id={releaseId(item.version)}
          data-release
          data-release-version={item.version}
          data-search-text={`${item.version} ${item.date} ${item.groups.flatMap((entry) => entry.items).join(" ")}`.toLowerCase()}
        >
          <header>
            <time datetime={item.date}>{formatDate(item.date)}</time>
            <h2>
              <a href={`https://github.com/awesomestvi/navet/releases/tag/v${item.version}`}>Navet {item.version}</a>
            </h2>
            {index === 0 && <span class="navet-release-latest">Archive</span>}
          </header>

          <div class="navet-release-groups">
            {item.groups.map((entry) => (
              <section data-change-kind={entry.kind}>
                <h3><span aria-hidden="true"></span>{entry.title}</h3>
                <ul>{entry.items.map((change) => <li set:html={renderInline(change)} />)}</ul>
              </section>
            ))}
          </div>
        </article>
      );
    })}
  </div>

  <div class="navet-changelog-source">
    <span aria-hidden="true">↻</span>
    <p><strong>Release archive.</strong> Current stable notes load directly from GitHub Releases; older entries remain in the historical <a href="https://github.com/awesomestvi/navet/blob/main/CHANGELOG.md">CHANGELOG.md</a>.</p>
  </div>
</div>

<script>
  import { parseReleaseGroups, parseCachedReleases, type FeedRelease } from "../utils/release-feed";
  import { loadReleaseCache, saveReleaseCache } from "../../../../packages/app/src/utils/public-release-cache";
  const RELEASES_API_URL = "https://api.github.com/repos/awesomestvi/navet/releases";
  const STABLE_TAG_PATTERN = /^v(\d+\.\d+\.\d+)$/;

  const releaseId = (version: string) => `release-${version.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
  const appendInlineMarkdown = (parent: HTMLElement, value: string) => {
    const pattern = /`([^`]+)`|\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g;
    let offset = 0;

    for (const match of value.matchAll(pattern)) {
      const index = match.index ?? 0;
      parent.append(document.createTextNode(value.slice(offset, index)));
      if (match[1]) {
        const code = document.createElement("code");
        code.textContent = match[1];
        parent.append(code);
      } else if (match[2] && match[3]) {
        const link = document.createElement("a");
        link.href = match[3];
        link.textContent = match[2];
        parent.append(link);
      }
      offset = index + match[0].length;
    }

    parent.append(document.createTextNode(value.slice(offset)));
  };

  const createReleaseArticle = (release: {
    version: string;
    date: string;
    url: string;
    groups: ReturnType<typeof parseReleaseGroups>;
  }) => {
    const article = document.createElement("article");
    article.className = "navet-release";
    article.id = releaseId(release.version);
    article.dataset.release = "";
    article.dataset.releaseVersion = release.version;
    article.dataset.searchText = `${release.version} ${release.date} ${release.groups.flatMap((entry) => entry.items).join(" ")}`.toLowerCase();

    const header = document.createElement("header");
    const time = document.createElement("time");
    time.dateTime = release.date;
    time.textContent = new Intl.DateTimeFormat("en", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(`${release.date}T00:00:00Z`));
    const heading = document.createElement("h2");
    const link = document.createElement("a");
    link.href = release.url;
    link.textContent = `Navet ${release.version}`;
    heading.append(link);
    header.append(time, heading);
    article.append(header);

    const groupList = document.createElement("div");
    groupList.className = "navet-release-groups";
    for (const entry of release.groups) {
      const section = document.createElement("section");
      section.dataset.changeKind = entry.kind;
      const sectionHeading = document.createElement("h3");
      const marker = document.createElement("span");
      marker.setAttribute("aria-hidden", "true");
      sectionHeading.append(marker, entry.title);
      const list = document.createElement("ul");
      for (const item of entry.items) {
        const listItem = document.createElement("li");
        appendInlineMarkdown(listItem, item);
        list.append(listItem);
      }
      section.append(sectionHeading, list);
      groupList.append(section);
    }
    article.append(groupList);
    return article;
  };

  const createTimelineItem = (version: string, date: string) => {
    const item = document.createElement("li");
    item.dataset.releaseVersion = version;
    const link = document.createElement("a");
    link.href = `#${releaseId(version)}`;
    const label = document.createElement("span");
    label.textContent = version;
    const time = document.createElement("time");
    time.dateTime = date;
    time.textContent = new Intl.DateTimeFormat("en", {
      day: "numeric",
      month: "short",
      timeZone: "UTC",
    }).format(new Date(`${date}T00:00:00Z`));
    link.append(label, time);
    item.append(link);
    return item;
  };

  const root = document.querySelector("[data-changelog]");

  if (root instanceof HTMLElement) {
    const filters = [...root.querySelectorAll("[data-change-filter]")];
    let releases = [...root.querySelectorAll("[data-release]")];
    const search = root.querySelector("[data-change-search]");
    const empty = root.querySelector("[data-change-empty]");
    const releaseList = root.querySelector(".navet-release-list");
    const timelineList = document.querySelector("[data-release-timeline-list]");
    let activeFilter = "all";

    const applyFilters = () => {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
      let visibleCount = 0;

      for (const release of releases) {
        if (!(release instanceof HTMLElement)) continue;
        const groups = [...release.querySelectorAll("[data-change-kind]")];
        let visibleGroups = 0;

        for (const group of groups) {
          if (!(group instanceof HTMLElement)) continue;
          const visible = activeFilter === "all" || group.dataset.changeKind?.split(" ").includes(activeFilter);
          group.hidden = !visible;
          if (visible) visibleGroups += 1;
        }

        const matchesSearch = !query || release.dataset.searchText?.includes(query);
        const visible = visibleGroups > 0 && matchesSearch;
        release.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      if (empty instanceof HTMLElement) empty.hidden = visibleCount !== 0;
    };

    for (const filter of filters) {
      filter.addEventListener("click", () => {
        if (!(filter instanceof HTMLButtonElement)) return;
        activeFilter = filter.dataset.changeFilter ?? "all";
        for (const item of filters) {
          const selected = item === filter;
          item.classList.toggle("is-active", selected);
          item.setAttribute("aria-pressed", String(selected));
        }
        applyFilters();
      });
    }

    search?.addEventListener("input", applyFilters);

    const archiveBoundary = releases.find(
      (release) => release instanceof HTMLElement
    )?.getAttribute("data-release-version");

    if (releaseList instanceof HTMLElement && archiveBoundary) {
      const loadStableReleases = async () => {
        let stableReleases: FeedRelease[] = [];
        const status = root.querySelector("[data-release-status]");
        let fresh = false;
        try {
        let reachedArchive = false;

        for (let page = 1; page <= 20 && !reachedArchive; page += 1) {
          const response = await fetch(`${RELEASES_API_URL}?per_page=100&page=${page}`, {
            headers: { Accept: "application/vnd.github+json" },
            signal: AbortSignal.timeout(10_000),
          });
          if (!response.ok) throw new Error(`GitHub releases request failed: ${response.status}`);
          const entries = await response.json();
          if (!Array.isArray(entries)) throw new Error("GitHub releases response was invalid.");

          for (const entry of entries) {
            if (!entry || typeof entry !== "object" || entry.draft || entry.prerelease) continue;
            const tagMatch = typeof entry.tag_name === "string"
              ? entry.tag_name.match(STABLE_TAG_PATTERN)
              : null;
            if (!tagMatch?.[1]) continue;
            if (tagMatch[1] === archiveBoundary) {
              reachedArchive = true;
              break;
            }
            if (
              typeof entry.body !== "string" ||
              typeof entry.html_url !== "string" ||
              typeof entry.published_at !== "string"
            ) continue;
            stableReleases.push({
              version: tagMatch[1],
              date: entry.published_at.slice(0, 10),
              url: entry.html_url,
              body: entry.body,
            });
          }

          if (entries.length < 100) break;
        }

        if (!reachedArchive && stableReleases.length === 0) throw new Error("Stable release history was not found.");
        stableReleases = parseCachedReleases(stableReleases);
        saveReleaseCache("docs", stableReleases, new Date().toISOString());
        fresh = true;
        if (status) status.textContent = "Stable release notes checked with GitHub.";
        } catch {
          const cached = loadReleaseCache("docs", parseCachedReleases);
          stableReleases = cached?.value ?? [];
          if (status) status.textContent = cached
            ? `Could not check for newer releases. Showing saved notes from ${new Date(cached.checkedAt).toLocaleDateString()} and the archive. Check GitHub for the latest release.`
            : "Could not check for newer releases. Showing the bundled archive. Check GitHub for the latest release.";
        }

        const existingVersions = new Set(
          releases.flatMap((release) =>
            release instanceof HTMLElement && release.dataset.releaseVersion
              ? [release.dataset.releaseVersion]
              : []
          )
        );
        const missingReleases = stableReleases.filter(
          (release) => !existingVersions.has(release.version)
        );
        if (missingReleases.length === 0) {
          const badge = root.querySelector(".navet-release-latest");
          if (badge) badge.textContent = fresh ? "Latest" : "Archive";
          return;
        }

        root.querySelector(".navet-release-latest")?.remove();
        timelineList?.querySelector(".is-active")?.classList.remove("is-active");
        timelineList?.querySelector("[aria-current]")?.removeAttribute("aria-current");
        for (const release of [...missingReleases].reverse()) {
          releaseList.prepend(createReleaseArticle({ ...release, groups: parseReleaseGroups(release.body) }));
          timelineList?.prepend(createTimelineItem(release.version, release.date));
        }

        const latestArticle = releaseList.querySelector("[data-release]");
        const latestHeader = latestArticle?.querySelector("header");
        if (latestHeader) {
          const badge = document.createElement("span");
          badge.className = "navet-release-latest";
          badge.textContent = fresh ? "Latest" : "Saved";
          latestHeader.append(badge);
        }
        const latestTimelineItem = timelineList?.querySelector("li");
        latestTimelineItem?.classList.add("is-active");
        latestTimelineItem?.querySelector("a")?.setAttribute("aria-current", "location");
        releases = [...root.querySelectorAll("[data-release]")];
        applyFilters();
        window.dispatchEvent(new Event("navet:release-timeline-refresh"));
      };

      loadStableReleases().catch(() => {
        // Keep the historical archive visible when GitHub is unavailable.
      });
    }
  }
</script>
