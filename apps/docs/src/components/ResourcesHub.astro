---
const showcases = [
  {
    title: "Energy without the spreadsheet",
    description: "Live consumption and source context designed to be understood in a few seconds.",
    image: "https://raw.githubusercontent.com/awesomestvi/navet/main/assets/reference/marketing/screenshots/navet-ipad-landscape-energy.jpg",
    alt: "Navet energy dashboard on an iPad",
  },
  {
    title: "Control that travels",
    description: "The same household dashboard, adapted for quick checks and actions on mobile.",
    image: "https://raw.githubusercontent.com/awesomestvi/navet/main/assets/reference/marketing/screenshots/navet-mobile-pwa-home.jpg",
    alt: "Navet mobile dashboard",
  },
];

const videos = [
  { lesson: 1, topic: "Setup", title: "Set up Navet and your first dashboard", videoId: "XEjrLwt5xiQ", duration: "6:29", type: "Tutorial", description: "Follow Home Assistant login, startup choices, and your first Home card.", href: "https://youtu.be/XEjrLwt5xiQ" },
  { lesson: 2, topic: "Dashboards", title: "Add cards and arrange Home", videoId: "8xis2yjmul8", duration: "3:45", type: "Tutorial", description: "Add cards, arrange sections with drag and drop, and check Home on a phone.", href: "https://youtu.be/8xis2yjmul8" },
];

// The remaining first-batch tutorials. Add a real video URL only after publication.
const plannedVideos = [
  { lesson: 3, title: "Change theme and accent", topic: "Appearance" },
  { lesson: 4, title: "Start music and choose the right speaker", topic: "Media · Home Assistant" },
  { lesson: 5, title: "Music player controls in depth", topic: "Media · Home Assistant" },
  { lesson: 6, title: "Create a group of speakers", topic: "Media · Home Assistant" },
  { lesson: 7, title: "Set up Household and chores", topic: "Household" },
  { lesson: 8, title: "Add and customize a chore", topic: "Household" },
  { lesson: 9, title: "Choose how your household uses points", topic: "Household" },
  { lesson: 10, title: "Earn points and understand the balance", topic: "Household" },
  { lesson: 11, title: "Add points manually", topic: "Household" },
  { lesson: 12, title: "Remove points and correct a balance", topic: "Household" },
];

const guides = [
  { type: "Start here", title: "Build your first dashboard", description: "Go from install to a useful first room without learning the whole system.", href: "/getting-started/" },
  { type: "Integration", title: "Connect Home Assistant", description: "Choose the installation that fits your Home Assistant setup.", href: "/install/home-assistant/" },
  { type: "Guide", title: "Find the right widget", description: "See what Navet can show and control across your home.", href: "/guide/widgets/" },
  { type: "Open source", title: "Shape Navet with us", description: "Explore the architecture, contribution flow, and public roadmap.", href: "/developers/contributing/" },
];
---

<div class="navet-resources">
  <section class="navet-resource-lead" aria-labelledby="resource-lead-title">
    <div>
      <p class="navet-resource-kicker">Explore the product</p>
      <h2 id="resource-lead-title">See how Navet fits into a real home.</h2>
      <p>Try the dashboard, inspect its building blocks, or catch up on what changed.</p>
    </div>
    <div class="navet-resource-actions">
      <a class="navet-resource-action navet-resource-action--primary" href="https://demo.navet.app/">
        <span>Live demo</span><small>Use a complete sample home</small><b aria-hidden="true">↗</b>
      </a>
      <a class="navet-resource-action" href="https://storybook.navet.app/">
        <span>Component library</span><small>Browse cards and UI patterns</small><b aria-hidden="true">↗</b>
      </a>
      <a class="navet-resource-action" href="/changelog/">
        <span>Changelog</span><small>Follow every stable release</small><b aria-hidden="true">→</b>
      </a>
    </div>
  </section>

  <section class="navet-resource-section" aria-labelledby="showcase-title">
    <div class="navet-resource-section-heading">
      <div><p>Showcase</p><h2 id="showcase-title">Designed for the screens you already have</h2></div>
      <a href="https://demo.navet.app/">Explore the demo <span aria-hidden="true">↗</span></a>
    </div>
    <div class="navet-showcase-grid">
      <article class="navet-showcase-card navet-showcase-card--wide">
        <iframe
          class="navet-showcase-teaser"
          src="https://www.youtube-nocookie.com/embed/FmdQCJASTZA"
          title="Navet — Your Smart Home, in One Place | 1-Minute Tour"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="fullscreen"
          allowfullscreen
        ></iframe>
        <div>
          <h3>Get to know Navet in one minute</h3>
          <p>See everyday home controls across desktop, tablet, and phone layouts.</p>
        </div>
      </article>
      {showcases.map((item) => (
        <article class="navet-showcase-card">
          <div class="navet-showcase-media"><img src={item.image} alt={item.alt} loading="lazy" /></div>
          <div><h3>{item.title}</h3><p>{item.description}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="navet-resource-section" aria-labelledby="guides-title">
    <div class="navet-resource-section-heading">
      <div><p>Guides & stories</p><h2 id="guides-title">A useful place to begin</h2></div>
    </div>
    <div class="navet-guide-grid">
      {guides.map((item) => (
        <a class="navet-guide-card" href={item.href}>
          <small>{item.type}</small><h3>{item.title}</h3><p>{item.description}</p><span aria-hidden="true">Read →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="navet-resource-section" aria-labelledby="videos-title">
    <div class="navet-resource-section-heading">
      <div><p>Watch now</p><h2 id="videos-title">Video walkthroughs</h2></div>
      <a href="https://www.youtube.com/@navetapp">All videos <span aria-hidden="true">↗</span></a>
    </div>
    <p class="navet-walkthrough-intro">Start with 01, then watch in order.</p>
    <div class="navet-walkthrough-grid">
      {videos.map((item) => (
        <a class="navet-walkthrough-card" href={item.href}>
          <div class="navet-walkthrough-media">
            <img src={`https://i.ytimg.com/vi/${item.videoId}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" />
            <span class="navet-walkthrough-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
            <span class="navet-walkthrough-duration">{item.duration}</span>
          </div>
          <div class="navet-walkthrough-copy">
            <small class="navet-walkthrough-lesson">{`${String(item.lesson).padStart(2, "0")} · ${item.topic}${item.lesson === 1 ? " · Start here" : ""}`}</small>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="navet-walkthrough-action">Watch tutorial <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </div>
    <div class="navet-planned-videos">
      <h3 id="planned-videos-title">Planned walkthroughs</h3>
      <p>Continue with 03–12 as they become available. These tutorials are planned; publication dates have not been set.</p>
      <ul class="navet-planned-video-list" aria-labelledby="planned-videos-title">
        {plannedVideos.map((item) => (
          <li>
            <div><small>{String(item.lesson).padStart(2, "0")} · {item.topic}</small><h4>{item.title}</h4></div>
            <span class="navet-video-status">Planned</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</div>
