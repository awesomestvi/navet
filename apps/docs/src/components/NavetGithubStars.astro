<navet-github-stars>
  <a
    class="navet-github-stars"
    href="https://github.com/awesomestvi/navet"
    target="_blank"
    rel="noreferrer"
    aria-label="Navet on GitHub"
  >
    <svg class="navet-github-mark" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.3-5.28-1.29-5.28-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.39-5.3 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"></path>
    </svg>
    <span class="navet-github-label">GitHub</span>
    <span class="navet-github-stars-meta" data-star-meta hidden>
      <svg class="navet-github-star" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m12 2.8 2.75 5.57 6.15.9-4.45 4.33 1.05 6.12L12 16.83l-5.5 2.89 1.05-6.12L3.1 9.27l6.15-.9L12 2.8Z"></path>
      </svg>
      <span data-star-count></span>
    </span>
  </a>
</navet-github-stars>

<script>
  const cacheKey = "navet:github-stars";
  const cacheTtl = 60 * 60 * 1000;
  const repoApiUrl = "https://api.github.com/repos/awesomestvi/navet";

  class NavetGithubStars extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      const cached = this.readCache();
      if (cached) {
        this.showCount(cached.count);
        return;
      }

      void this.loadCount();
    }

    disconnectedCallback() {
      this.controller.abort();
    }

    private readCache(): { count: number; expiresAt: number } | null {
      try {
        const value = localStorage.getItem(cacheKey);
        if (!value) return null;
        const cached = JSON.parse(value) as { count?: unknown; expiresAt?: unknown };
        if (
          typeof cached.count !== "number" ||
          typeof cached.expiresAt !== "number" ||
          cached.expiresAt <= Date.now()
        ) {
          return null;
        }
        return { count: cached.count, expiresAt: cached.expiresAt };
      } catch {
        return null;
      }
    }

    private async loadCount() {
      try {
        const response = await fetch(repoApiUrl, {
          headers: { Accept: "application/vnd.github+json" },
          signal: this.controller.signal,
        });
        if (!response.ok) return;

        const payload = (await response.json()) as { stargazers_count?: number };
        if (typeof payload.stargazers_count !== "number") return;

        localStorage.setItem(
          cacheKey,
          JSON.stringify({
            count: payload.stargazers_count,
            expiresAt: Date.now() + cacheTtl,
          }),
        );
        this.showCount(payload.stargazers_count);
      } catch {
        // The GitHub link remains usable when the unauthenticated API is unavailable.
      }
    }

    private showCount(count: number) {
      const meta = this.querySelector<HTMLElement>("[data-star-meta]");
      const value = this.querySelector<HTMLElement>("[data-star-count]");
      const link = this.querySelector<HTMLAnchorElement>("a");
      if (!meta || !value || !link) return;

      value.textContent = new Intl.NumberFormat("en-US", {
        notation: "compact",
        maximumFractionDigits: 1,
      }).format(count);
      meta.hidden = false;
      link.setAttribute("aria-label", `Navet on GitHub, ${count.toLocaleString("en-US")} stars`);
    }
  }

  if (!customElements.get("navet-github-stars")) {
    customElements.define("navet-github-stars", NavetGithubStars);
  }
</script>
